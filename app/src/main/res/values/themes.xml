<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CloudReel" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/cr_background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/cr_background_light</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.CloudReel.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cr_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/cloudreel_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.CloudReel</item>
    </style>
</resources>
