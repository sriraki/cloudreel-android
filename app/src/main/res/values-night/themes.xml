<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CloudReel" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/cr_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/cr_background_dark</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.CloudReel.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cr_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.CloudReel</item>
    </style>
</resources>
